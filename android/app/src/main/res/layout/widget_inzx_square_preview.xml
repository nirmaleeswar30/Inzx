<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview: the real layout with a sample cover and text. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_inzx_art_placeholder">

    <ImageView
        android:id="@+id/widget_art"
        android:src="@drawable/widget_inzx_preview_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_inzx_artwork"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="@dimen/widget_inzx_logo"
        android:layout_height="@dimen/widget_inzx_logo"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:alpha="0.92"
        android:contentDescription="@string/widget_inzx_logo"
        android:src="@drawable/widget_inzx_logo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_inzx_band_square"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal|bottom"
        android:orientation="vertical"
        android:paddingLeft="@dimen/widget_inzx_band_padding"
        android:paddingRight="@dimen/widget_inzx_band_padding"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_title"
                android:text="Song title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_previous"
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_inzx_button_square"
                android:layout_weight="1"
                android:background="@drawable/widget_inzx_button"
                android:contentDescription="@string/widget_inzx_previous"
                android:padding="9dp"
                android:src="@drawable/ic_inzx_widget_previous" />

            <ImageView
                android:id="@+id/widget_toggle"
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_inzx_button_square"
                android:layout_weight="1"
                android:background="@drawable/widget_inzx_button"
                android:contentDescription="@string/widget_inzx_play_pause"
                android:padding="8dp"
                android:src="@drawable/ic_inzx_widget_pause" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_inzx_button_square"
                android:layout_weight="1"
                android:background="@drawable/widget_inzx_button"
                android:contentDescription="@string/widget_inzx_next"
                android:padding="9dp"
                android:src="@drawable/ic_inzx_widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
