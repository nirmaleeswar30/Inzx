<?xml version="1.0" encoding="utf-8"?>
<!--
  4×1: a capsule centred in its row. Round cover on the left; the title (with
  the Inzx logo at its right) over Like / previous / play / next / Shuffle.
  The capsule body is the cover blurred down to its colours (baked by
  InzxWidgetArt.pill); until it arrives the translucent shape stands in.
  Spacers are empty FrameLayouts: RemoteViews refuses to inflate a plain View.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_inzx_pill_height"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_pill_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_inzx_pill_bg"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="7dp"
            android:paddingRight="12dp">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="@dimen/widget_inzx_pill_art"
                android:layout_height="@dimen/widget_inzx_pill_art"
                android:background="@drawable/widget_inzx_circle_placeholder"
                android:contentDescription="@string/widget_inzx_artwork"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:paddingLeft="10dp"
                        android:paddingRight="6dp"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/widget_logo"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginRight="4dp"
                        android:alpha="0.92"
                        android:contentDescription="@string/widget_inzx_logo"
                        android:src="@drawable/widget_inzx_logo" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_inzx_button_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_like"
                        android:layout_width="@dimen/widget_inzx_button_pill"
                        android:layout_height="@dimen/widget_inzx_button_pill"
                        android:background="@drawable/widget_inzx_button"
                        android:contentDescription="@string/widget_inzx_like"
                        android:padding="9dp"
                        android:src="@drawable/ic_inzx_widget_heart" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/widget_previous"
                        android:layout_width="@dimen/widget_inzx_button_pill"
                        android:layout_height="@dimen/widget_inzx_button_pill"
                        android:background="@drawable/widget_inzx_button"
                        android:contentDescription="@string/widget_inzx_previous"
                        android:padding="7dp"
                        android:src="@drawable/ic_inzx_widget_previous" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/widget_toggle"
                        android:layout_width="@dimen/widget_inzx_button_pill"
                        android:layout_height="@dimen/widget_inzx_button_pill"
                        android:background="@drawable/widget_inzx_button"
                        android:contentDescription="@string/widget_inzx_play_pause"
                        android:padding="5dp"
                        android:src="@drawable/ic_inzx_widget_play" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/widget_next"
                        android:layout_width="@dimen/widget_inzx_button_pill"
                        android:layout_height="@dimen/widget_inzx_button_pill"
                        android:background="@drawable/widget_inzx_button"
                        android:contentDescription="@string/widget_inzx_next"
                        android:padding="7dp"
                        android:src="@drawable/ic_inzx_widget_next" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/widget_shuffle"
                        android:layout_width="@dimen/widget_inzx_button_pill"
                        android:layout_height="@dimen/widget_inzx_button_pill"
                        android:background="@drawable/widget_inzx_button"
                        android:contentDescription="@string/widget_inzx_shuffle"
                        android:padding="9dp"
                        android:src="@drawable/ic_inzx_widget_shuffle" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
