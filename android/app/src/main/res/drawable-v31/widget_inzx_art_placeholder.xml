<?xml version="1.0" encoding="utf-8"?>
<!--
  Shown behind the cover widgets until (or instead of) the artwork. On 12+ the
  widget is clipped to this outline, so it takes the launcher's own widget
  corner radius and the cover can never sit inside a different curve.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
    <gradient
        android:angle="270"
        android:endColor="#FF0A0A0C"
        android:startColor="#FF3A0A10" />
</shape>
